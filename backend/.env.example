# ===========================================
# Bible Mind Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/biblemind"

# JWT Secret for Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# OAuth Credentials (optional for MVP)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Redis URL (optional, for caching)
REDIS_URL="redis://localhost:6379"

# ElasticSearch URL (optional, for advanced search)
ELASTICSEARCH_URL="http://localhost:9200"

# Gemini AI API Key (existing)
GEMINI_API_KEY=""

# OpenRouter API Keys for AI Features
OPENROUTER_API_KEY=""
OPENROUTER_FLUX_API_KEY=""
AGENTROUTER_API_KEY=""

# Hugging Face Token
HUGGINGFACE_TOKEN=""

# Environment
NODE_ENV="development"
PORT=3001
